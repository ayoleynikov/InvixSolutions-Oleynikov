# PostgreSQL
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_secret
POSTGRES_DB=catalog
DATABASE_URL=postgresql://catalog:catalog_secret@postgres:5432/catalog

# MinIO локально; на Render — S3-compatible (R2 и т.п.)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=products
MINIO_PUBLIC_URL=http://localhost:9000
# MINIO_PUBLIC_URL_OMIT_BUCKET — если нужно явно (для *.r2.dev часто само)
# true на проде с HTTPS (R2/S3), локально false
MINIO_SECURE=false

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# Bot
BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_IDS=123456789
WEBAPP_URL=http://localhost:3000
API_URL=http://api:8000
BOT_MODE=polling
# Webhook (when BOT_MODE=webhook)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook
WEBHOOK_URL=https://your-domain.com/webhook

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
# на Render SSR в api по внутренней сети (render.yaml)
# API_INTERNAL_HOST=
# API_INTERNAL_PORT=
